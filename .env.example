# Spartan Gate public environment template.
# Copy to .env for a portable local run. Put real secrets and personal paths in private/.

COMPOSE_PROJECT_NAME=spartan-gate
# Browser backend profile selected by CAMOFOX_URL. Keep browserless when
# CAMOFOX_URL is empty; use camofox when CAMOFOX_URL=http://camofox:9377.
COMPOSE_PROFILES=browserless

# Edge ports. Public Compose binds these to 127.0.0.1 only.
# Change these if another local service already uses the same ports.
SPARTAN_BIND_LOCALHOST=127.0.0.1
SPARTAN_GATE_PORT=18789
CLAWROUTE_EDGE_PORT=18790
BROWSERLESS_DEBUG_PORT=3005
HERMES_DASHBOARD_PORT=9119

# Bounded Docker local logs. Each service retains at most size x files.
SPARTAN_LOG_MAX_SIZE=10m
SPARTAN_LOG_MAX_FILES=3

# Internal Docker network. Change both values together if this conflicts with another Docker bridge.
SPARTAN_INTERNAL_SUBNET=172.28.0.0/24
SPARTAN_DNS_IP=172.28.0.253

# Keep false for fresh installs. Set true only for an intentional cutover where
# private data paths point at an existing/old stack and that stack is stopped.
SPARTAN_ALLOW_EXISTING_STACK_PATHS=false

# Host identities used by non-root Caddy and router containers.
SPARTAN_CADDY_UID=1000
SPARTAN_CADDY_GID=1000
SPARTAN_ROUTE_UID=1000
SPARTAN_ROUTE_GID=1000
SPARTAN_CLAWROUTE_UID=1000
SPARTAN_CLAWROUTE_GID=1000

# Caddy Basic Auth. Default hash is for the placeholder password "change-me".
CADDY_AUTH_USER=admin
CADDY_AUTH_HASH='$2a$14$UMuSzA3WdVqcAwE3yvFeCO.CesMjqqGDVrxpL1s87FsWM/NRrADi2'

# Shared internal tokens. Replace before using beyond local experiments.
HERMES_API_KEY=change-me-hermes-api-key
HERMES_GATEWAY_TOKEN=change-me-hermes-gateway-token
CLAWROUTE_TOKEN=change-me-clawroute-token
# 64 lowercase hex characters; generate with: openssl rand -hex 32
SPARTAN_REASONING_BINDING_SECRET=
BROWSERLESS_TOKEN=change-me-browserless-token
BROWSERLESS_EDGE_TOKEN=change-me-browserless-edge-token
CADDY_CAMOFOX_EDGE_TOKEN=change-me-caddy-camofox-edge-token
CADDY_WS_EDGE_TOKEN=change-me-caddy-ws-edge-token
BROWSERLESS_IMAGE=spartan-gate-browserless:2.51.0
BROWSERLESS_BASE_IMAGE=ghcr.io/browserless/chromium:v2.51.0
BROWSERLESS_DEBUG_ORIGIN=

# Optional local English/Spanish Pocket TTS sidecar. Add pocket-tts to
# COMPOSE_PROFILES only after the one-shot prefetch succeeds.
POCKET_TTS_IMAGE=spartan-gate-pocket-tts:2.1.0
POCKET_TTS_DATA_PATH=../../runtime/pocket-tts

# Persistent login profile used by the optional browser profile main.
# For Google Meet with an authenticated account, use BROWSERLESS_PROFILE=google
# together with HERMES_MEET_CDP_PROFILE=google, then seed accounts.google.com.
BROWSERLESS_PROFILE=main
BROWSERLESS_CDP_BROKER_ENABLED=true
BROWSERLESS_CDP_BROKER_PORT=9229
BROWSERLESS_CDP_BROKER_TRACE=false
BROWSERLESS_SESSION_TIMEOUT_MS=2147483647
BROWSERLESS_IGNORE_DEFAULT_ARGS=false
BROWSERLESS_HEADLESS=true
BROWSERLESS_STEALTH_ENDPOINT=true
BROWSERLESS_ROUTE=chromium
BROWSERLESS_STEALTH_ROUTE=chromium
BROWSERLESS_LANG=es-ES
BROWSERLESS_USER_AGENT=
BROWSERLESS_TZ=Europe/Madrid
SPARTAN_WHITELIST_REFRESH_TIME=02:00
SPARTAN_WHITELIST_REFRESH_TZ=Europe/Madrid
SPARTAN_WHITELIST_MAX_BYTES=262144
SPARTAN_WHITELIST_MAX_ENTRIES=2048
BROWSERLESS_PROFILES_GID=1000

# Optional Camofox browser backend. Leave CAMOFOX_URL empty to keep Browserless
# as Hermes' default browser/CDP backend.
CAMOFOX_URL=
CAMOFOX_BASE_IMAGE=ghcr.io/jo-inc/camofox-browser:1.14.0@sha256:86c79eed8a6b3a78859f73bc70d6003c5566b85e969354ec454524b28197ffce
CAMOFOX_IMAGE=spartan-gate-camofox:1.14.0
CAMOFOX_ACCESS_KEY=change-me-camofox-access-key
CAMOFOX_API_KEY=
CAMOFOX_ADMIN_KEY=
# Generic Hermes clients must use client/profile-scoped identities.
CAMOFOX_USER_ID=
CAMOFOX_SESSION_KEY=
CAMOFOX_ADOPT_EXISTING_TAB=false
# Set true (or 1) for analytics QA or custom add-ons; false keeps upstream UBO.
# Camofox fails closed if CAMOFOX_ADDONS is non-empty while this remains false.
CAMOFOX_DISABLE_DEFAULT_ADDONS=false
# Single-owner Google Meet compatibility session; blank uses its "meet" default.
HERMES_MEET_CAMOFOX_SESSION_KEY=
CAMOFOX_GEOIP=false
# Comma-separated extracted add-on paths inside the Camofox container.
CAMOFOX_ADDONS=
CAMOFOX_ENABLE_VNC=0
CAMOFOX_VNC_PASSWORD=
CAMOFOX_NOVNC_PORT=26080
CAMOFOX_MAX_CONCURRENT_PER_USER=2
CAMOFOX_MAX_CONCURRENT_CREATES=1
CAMOFOX_MAX_SESSIONS=8
CAMOFOX_MAX_TABS_PER_SESSION=4
CAMOFOX_MAX_TABS_GLOBAL=12
CAMOFOX_SESSION_TIMEOUT_MS=600000
CAMOFOX_TAB_INACTIVITY_MS=300000
CAMOFOX_BROWSER_IDLE_TIMEOUT_MS=300000
CAMOFOX_TRACES_MAX_BYTES=52428800
CAMOFOX_TRACES_TTL_HOURS=24
CAMOFOX_MAX_OLD_SPACE_SIZE=256

HERMES_MEET_CDP_PROFILE=guest
# Override Meet to use real host Chrome CDP instead of Browserless, e.g. http://172.29.0.1:9222
HERMES_MEET_CDP_URL=

# Hermes portable defaults.
HERMES_DASHBOARD=1
HERMES_DASHBOARD_INSECURE=1
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me-dashboard-password
HERMES_DASHBOARD_BASIC_AUTH_SECRET=change-me-dashboard-secret
HERMES_API_PORT=8642
HERMES_MAX_ITERATIONS=90
HERMES_UID=1000
HERMES_GID=1000

# Hermes diagnostics and s6 profile bootstrap. Profile-specific secrets belong in private env files.
# HERMES_AUTOSTART_PROFILES only seeds missing gateway_state.json as running; use
# `hermes -p <profile> gateway start|stop` for normal lifecycle changes.
HERMES_AUTOSTART_PROFILES=
HERMES_DUMP_REQUESTS=false
HERMES_DUMP_REQUEST_STDOUT=false

# Main Hermes messaging integrations.
HERMES_TELEGRAM_BOT_TOKEN=
HERMES_TELEGRAM_ALLOWED_USERS=
TELEGRAM_DM_POLICY=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
DISCORD_HOME_CHANNEL=

# Example gateway profile variables. Add more by copying this pattern.
# Profile files can reference these as TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN_COACH}, etc.
HERMES_TELEGRAM_BOT_TOKEN_COACH=
HERMES_TELEGRAM_ALLOWED_USERS_COACH=
DISCORD_BOT_TOKEN_COACH=
DISCORD_ALLOWED_USERS_COACH=
DISCORD_HOME_CHANNEL_COACH=
HERMES_TELEGRAM_BOT_TOKEN_WORK=
HERMES_TELEGRAM_ALLOWED_USERS_WORK=
DISCORD_BOT_TOKEN_WORK=
DISCORD_ALLOWED_USERS_WORK=
DISCORD_HOME_CHANNEL_WORK=
HERMES_TELEGRAM_BOT_TOKEN_MARKET=
HERMES_TELEGRAM_ALLOWED_USERS_MARKET=
DISCORD_BOT_TOKEN_MARKET=
DISCORD_ALLOWED_USERS_MARKET=
DISCORD_HOME_CHANNEL_MARKET=

# Optional Hermes tools and external integrations.
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_EMAIL=
COPILOT_GITHUB_TOKEN=
RAINDROP_API_KEY=
GOOGLE_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
GOG_KEYRING_PASSWORD=
FRED_API_KEY=
MASSIVE_API_KEY=
FINNHUB_API_KEY=

# Router compatibility defaults. L4 uses Spartan Route; lower-tier legacy
# addons can still use ClawRoute with the same public variable names.
CLAWROUTE_ENABLED=true
CLAWROUTE_BASELINE_MODEL=openrouter/anthropic/claude-sonnet-4.6
CLAWROUTE_PROVIDER=
CLAWROUTE_DEBUG=false
CLAWROUTE_DRY_RUN=false
CLAWROUTE_LOG_CONTENT=false
# Spartan Route telemetry admission and maintenance bounds.
SPARTAN_ROUTE_TELEMETRY_QUEUE_CAPACITY=1024
SPARTAN_ROUTE_TELEMETRY_RETENTION_BATCH_SIZE=256
SPARTAN_ROUTE_TELEMETRY_SHUTDOWN_TIMEOUT_MS=5000
CODEX_EARLY_ACTIVATION_ENABLED=true
CODEX_EARLY_ACTIVATION_WEEKLY_PERCENT=70
CODEX_ROTATION_INTERVAL_HOURS=2
CODEX_ROTATION_IDLE_MINUTES=30
CODEX_BALANCE_LOADER_MODE=off
CODEX_SCHEDULE_START_DAY=mon
OLLAMA_ENDPOINT=http://ollama:11434

# Provider keys are intentionally empty here. Put real values in private/env/local.env.
OPENAI_API_KEY=
CLOUDFLARE_API_TOKEN=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
STEPFUN_API_KEY=
OPENAI_CODEX_TOKEN=
OPENAI_CODEX_AUTH_PATH=
OPENAI_CODEX_AUTH_PATHS=
CODEX_HOME=
SPARTAN_ROUTE_DATA_PATH=../../runtime/spartan-route
SPARTAN_ROUTE_DB_PATH=/app/data/spartan-route.db

# Optional ClawRoute alerts.
CLAWROUTE_ALERT_EMAIL=
CLAWROUTE_ALERT_SLACK_WEBHOOK=

# Reader.
READER_TIMEOUT=15
READER_WORKERS=4
READER_MAX_PENDING=8

# Optional subscription-only Realtime. Provision a distinct voice-client credential
# and private digest/slot registry before enabling; no paid API-key fallback.
SPARTAN_ROUTE_REALTIME_ENABLED=false
SPARTAN_ROUTE_REALTIME_MODEL=
SPARTAN_ROUTE_REALTIME_CLIENTS_FILE=
