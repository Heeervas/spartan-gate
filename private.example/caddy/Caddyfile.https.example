{
	admin off
}

(hermes_extension_api) {
	route {
		@extension_preflight {
			method OPTIONS
			header Origin "{$HERMES_BROWSER_EXTENSION_ORIGIN}"
		}
		handle @extension_preflight {
			header Access-Control-Allow-Origin "{$HERMES_BROWSER_EXTENSION_ORIGIN}"
			header Access-Control-Allow-Methods "GET, POST, PATCH, DELETE, OPTIONS"
			header Access-Control-Allow-Headers "Authorization, Content-Type, Idempotency-Key, X-Hermes-Profile, X-Hermes-Session-Id, X-Hermes-Session-Key"
			header Access-Control-Max-Age "600"
			header Vary "Origin, Access-Control-Request-Method, Access-Control-Request-Headers"
			respond 204
		}

		@other_preflight method OPTIONS
		handle @other_preflight {
			respond 403
		}

		@extension_authorized header Authorization "Bearer {$HERMES_EXTENSION_EDGE_KEY}"
		handle @extension_authorized {
			reverse_proxy http://hermes:{args[0]} {
				header_up Authorization "Bearer {$HERMES_API_KEY}"
				header_up -X-Hermes-Profile
				header_up X-Real-IP {remote_host}
				header_down Access-Control-Allow-Origin "{$HERMES_BROWSER_EXTENSION_ORIGIN}"
				header_down Access-Control-Expose-Headers "X-Hermes-Session-Id, X-Hermes-Session-Key"
				header_down Vary "Origin"
				header_down -Access-Control-Allow-Headers
				header_down -Access-Control-Allow-Methods
				header_down -Access-Control-Max-Age
			}
		}

		handle {
			header Access-Control-Allow-Origin "{$HERMES_BROWSER_EXTENSION_ORIGIN}"
			header Vary "Origin"
			respond "Unauthorized" 401
		}
	}
}

:8642 {
	route {
		@ambiguous_agent_path {
			vars_regexp unsafe_agent_uri {http.request.uri} `(?i)^/agents/[^?]*(/\.\.?(/|$)|//|%2f|%5c|%2e|%25|\\)`
		}
		handle @ambiguous_agent_path {
			respond "Invalid Hermes gateway path" 400
		}

		handle_path /agents/default/* {
			import hermes_extension_api 8642
		}

		handle_path /agents/coach/* {
			import hermes_extension_api 8643
		}

		handle_path /agents/work/* {
			import hermes_extension_api 8644
		}

		handle_path /agents/market/* {
			import hermes_extension_api 8645
		}

		handle_path /agents/dreamer/* {
			import hermes_extension_api 8646
		}

		@unknown_agent_path path /agents /agents/*
		handle @unknown_agent_path {
			respond "Unknown Hermes gateway profile" 404
		}

		handle {
			import hermes_extension_api {$HERMES_API_PORT:8642}
		}
	}
}

:18789 {
	tls {$SPARTAN_CADDY_TLS_CERT_FILE:/certs/cert.pem} {$SPARTAN_CADDY_TLS_KEY_FILE:/certs/key.pem}

	@not_websocket {
		not header Connection *Upgrade*
	}

	basic_auth @not_websocket {
		{$CADDY_AUTH_USER:admin} {$CADDY_AUTH_HASH}
	}

	reverse_proxy http://hermes:{$HERMES_API_PORT:8642} {
		header_up -Authorization
		header_up X-Real-IP {remote_host}
	}
}

:18790 {
	tls {$SPARTAN_CADDY_TLS_CERT_FILE:/certs/cert.pem} {$SPARTAN_CADDY_TLS_KEY_FILE:/certs/key.pem}

	basic_auth {
		{$CADDY_AUTH_USER:admin} {$CADDY_AUTH_HASH}
	}

	reverse_proxy http://spartan-route:18790 {
		header_up Authorization "Bearer {$CLAWROUTE_TOKEN}"
	}
}

:3005 {
	tls {$SPARTAN_CADDY_TLS_CERT_FILE:/certs/cert.pem} {$SPARTAN_CADDY_TLS_KEY_FILE:/certs/key.pem}

	@browserless_websocket {
		header Connection *Upgrade*
	}

	@browserless_websocket_authorized {
		header Connection *Upgrade*
		query sgEdgeToken={$BROWSERLESS_EDGE_TOKEN:change-me-browserless-edge-token}
	}

	handle @browserless_websocket_authorized {
		reverse_proxy http://browserless:3000 {
			header_up Authorization "Bearer {$BROWSERLESS_TOKEN}"
			header_up Host {host}
		}
	}

	handle @browserless_websocket {
		respond "Unauthorized" 401
	}

	handle {
		basic_auth {
			{$CADDY_AUTH_USER:admin} {$CADDY_AUTH_HASH}
		}

		@debugger_router path /debugger/router.js
		handle @debugger_router {
			rewrite * /router.js
			root * /srv/browserless-debugger
			file_server
		}

		handle {
			reverse_proxy http://browserless:3000 {
				header_up Authorization "Bearer {$BROWSERLESS_TOKEN}"
				header_up Host {host}
			}
		}
	}
}

:9119 {
	tls {$SPARTAN_CADDY_TLS_CERT_FILE:/certs/cert.pem} {$SPARTAN_CADDY_TLS_KEY_FILE:/certs/key.pem}

	# Hermes dashboard serves its own application auth, /api, and /ws routes.
	# Keep these pass-through routes outside Caddy Basic Auth so Hermes Desktop
	# can establish its application session; Hermes remains the auth authority.
	@dashboard_internal path /login /auth/* /api/* /ws/*
	handle @dashboard_internal {
		reverse_proxy http://hermes:9119 {
			header_up Host {host}
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		basic_auth {
			{$CADDY_AUTH_USER:admin} {$CADDY_AUTH_HASH}
		}
		reverse_proxy http://hermes:9119
	}
}

:26080 {
	tls {$SPARTAN_CADDY_TLS_CERT_FILE:/certs/cert.pem} {$SPARTAN_CADDY_TLS_KEY_FILE:/certs/key.pem}

	@camofox_websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}

	@camofox_session_authorized {
		vars {cookie.spartan_edge_camofox} {$CADDY_CAMOFOX_EDGE_TOKEN}
	}

	@camofox_only_edge_cookies {
		header_regexp Cookie "^[ \t]*((spartan_ws_edge|spartan_edge_[A-Za-z0-9_]+)=[^;]*[; \t]*)+$"
	}

	handle @camofox_session_authorized {
		route {
			header Cache-Control "no-store"
			header +Set-Cookie "spartan_ws_edge=; Path=/; Max-Age=0; HttpOnly; SameSite=Strict; Secure"
			request_header @camofox_only_edge_cookies -Cookie
			request_header Cookie "^([ \t]*(spartan_ws_edge|spartan_edge_[A-Za-z0-9_]+)=[^;]*(;[ \t]*)?)+" ""
			request_header Cookie ";[ \t]*(spartan_ws_edge|spartan_edge_[A-Za-z0-9_]+)=[^;]*" ""
			request_header -Authorization
			reverse_proxy http://camofox:6080
		}
	}

	handle @camofox_websocket {
		respond "Unauthorized" 401
	}

	handle {
		route {
			basic_auth {
				{$CADDY_AUTH_USER:admin} {$CADDY_AUTH_HASH}
			}
			header {
				Cache-Control "no-store"
				+Set-Cookie "spartan_edge_camofox={$CADDY_CAMOFOX_EDGE_TOKEN}; Path=/; Max-Age=3600; HttpOnly; SameSite=Strict; Secure"
				+Set-Cookie "spartan_ws_edge=; Path=/; Max-Age=0; HttpOnly; SameSite=Strict; Secure"
			}
			request_header @camofox_only_edge_cookies -Cookie
			request_header Cookie "^([ \t]*(spartan_ws_edge|spartan_edge_[A-Za-z0-9_]+)=[^;]*(;[ \t]*)?)+" ""
			request_header Cookie ";[ \t]*(spartan_ws_edge|spartan_edge_[A-Za-z0-9_]+)=[^;]*" ""
			request_header -Authorization
			reverse_proxy http://camofox:6080
		}
	}
}

import /etc/caddy/local.d/*.caddy
