    "enabled": false,
    "storeRoot": "/opt/data/pi/agent/subagents/schedules"
  },
  "missions": {
    "enabled": false,
    "globalIndex": false
  },
  "disabledFeatures": [
    "workflow-scripts",
    "agent-management",
    "missions",
    "external-machines",
    "panes",
    "lane-management",
    "watchdog"
  ],
  "orcaProgressTabs": {
    "enabled": false
  }
}
