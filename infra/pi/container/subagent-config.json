{
  "autoResume": false,
  "asyncByDefault": true,
  "forceTopLevelAsync": true,
  "defaultSubagentContext": "fresh",
  "maxSubagentDepth": 1,
  "artifactDir": "session",
  "defaultSessionDir": "/opt/data/pi/agent/subagents/sessions",
  "singleRunOutputBaseDir": "/opt/data/pi/agent/subagents/outputs",
