{
  "defaultProvider": "spartan-route",
  "defaultModel": "codex/gpt-6.1-sol-282kcontext",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "spartan-route/codex/gpt-6.1-sol-282kcontext"
  ],
  "enableInstallTelemetry": false,
  "cacheWarming": "off",
  "packages": [],
  "extensions": [
    "-builtin:mcp",
    "-builtin:llama.cpp",
    "-builtin:codemode",
    "-builtin:tool-search",
    "/opt/pi-route-extensions/spartan-route.ts",
    "/opt/pi-route-extensions/spartan-route-cache.ts",
    "/opt/pi-route-extensions/spartan-route-usage.ts",
    "/opt/pi-container/subagents.ts",
    "/opt/pi-codex-fast/extensions/codex-fast.ts"
  ],
  "skills": [
    "/opt/shared-skills/shared-skills",
    "/opt/shared-skills/agent-managed-projects",
    "/opt/shared-skills/agent-team-orchestration",
    "/opt/shared-skills/builder-assurance",
    "/opt/shared-skills/builder-engineering-rules",
    "/opt/shared-skills/builder-behavioral-verification",
    "/opt/shared-skills/systematic-debugging",
    "/opt/shared-skills/test-audit",
    "/opt/shared-skills/requesting-code-review"
  ],
  "prompts": [],
  "themes": [],
  "subagents": {
    "disableBuiltins": true,
    "defaultExtensions": [
      "/opt/pi-route-extensions/spartan-route.ts",
      "/opt/pi-route-extensions/spartan-route-cache.ts",
      "/opt/pi-route-extensions/spartan-route-usage.ts",
      "/opt/pi-codex-fast/extensions/codex-fast.ts"
    ],
    "agentExcludeDirs": [
      "/root/.agents/skills"
    ],
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "spartan-route/codex/gpt-6-luna*",
        "spartan-route/codex/gpt-6.1-sol*",
        "spartan-route/codex/gpt-6.1-terra*",
        "spartan-route/codex/gpt-6-astra*"
      ]
    }
  }
}
