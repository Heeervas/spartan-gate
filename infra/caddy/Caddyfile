{
	admin off
}

:18789 {
	@not_websocket {
		not header Connection *Upgrade*
	}

	basic_auth @not_websocket {
		{$CADDY_AUTH_USER:admin} {$CADDY_AUTH_HASH}
	}

	reverse_proxy http://hermes:{$HERMES_API_PORT:8642} {
		header_up -Authorization
		header_up X-Real-IP {remote_host}
	}
}

import /etc/caddy/route.d/*.caddy

:9119 {
	# Hermes dashboard serves its own application auth, /api, and /ws routes.
	# Keep these pass-through routes outside Caddy Basic Auth so Hermes Desktop
	# can establish its application session; Hermes remains the auth authority.
	@dashboard_internal path /login /auth/* /api/* /ws/*
	handle @dashboard_internal {
		reverse_proxy http://hermes:9119
	}

	handle {
		basic_auth {
			{$CADDY_AUTH_USER:admin} {$CADDY_AUTH_HASH}
		}
		reverse_proxy http://hermes:9119
	}
}

:26080 {
	route {
	request_header -X-Edge-Valid
	request_header -X-Edge-Cookie
	forward_auth edge-sessions:9080 {
		uri /verify/camofox
		header_up X-Edge-Service-Key {$CADDY_SESSION_SERVICE_KEY}
		copy_headers X-Edge-Valid
	}
	@camofox_websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}

	@camofox_session_authorized {
		header X-Edge-Valid yes
	}

	@camofox_only_edge_cookies {
		header_regexp Cookie "^[ \t]*((spartan_ws_edge|spartan_edge_[A-Za-z0-9_]+)=[^;]*[; \t]*)+$"
	}

	handle @camofox_session_authorized {
		route {
			header Cache-Control "no-store"
			header +Set-Cookie "spartan_ws_edge=; Path=/; Max-Age=0; HttpOnly; SameSite=Strict"
			request_header @camofox_only_edge_cookies -Cookie
			request_header Cookie "^([ \t]*(spartan_ws_edge|spartan_edge_[A-Za-z0-9_]+)=[^;]*(;[ \t]*)?)+" ""
			request_header Cookie ";[ \t]*(spartan_ws_edge|spartan_edge_[A-Za-z0-9_]+)=[^;]*" ""
			request_header -Authorization
			request_header -X-Edge-Valid
			request_header -X-Edge-Service-Key
			request_header -X-Edge-Cookie
			reverse_proxy http://camofox:6080
		}
	}

	handle @camofox_websocket {
		respond "Unauthorized" 401
	}

	handle {
		route {
			basic_auth {
				{$CADDY_AUTH_USER:admin} {$CADDY_AUTH_HASH}
			}
			forward_auth edge-sessions:9080 {
				uri /mint/camofox
				header_up X-Edge-Service-Key {$CADDY_SESSION_SERVICE_KEY}
				header_up X-Edge-Secure no
				copy_headers X-Edge-Cookie
			}
			header {
				Cache-Control "no-store"
				+Set-Cookie "{http.request.header.X-Edge-Cookie}"
				+Set-Cookie "spartan_ws_edge=; Path=/; Max-Age=0; HttpOnly; SameSite=Strict"
			}
			request_header @camofox_only_edge_cookies -Cookie
			request_header Cookie "^([ \t]*(spartan_ws_edge|spartan_edge_[A-Za-z0-9_]+)=[^;]*(;[ \t]*)?)+" ""
			request_header Cookie ";[ \t]*(spartan_ws_edge|spartan_edge_[A-Za-z0-9_]+)=[^;]*" ""
			request_header -Authorization
			request_header -X-Edge-Valid
			request_header -X-Edge-Service-Key
			request_header -X-Edge-Cookie
			reverse_proxy http://camofox:6080
		}
	}
	}
}

import /etc/caddy/local.d/*.caddy
